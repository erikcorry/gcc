# libgcc2.c is built with 32-bit words (LIBGCC2_UNITS_PER_WORD in fructus.h),
# so what it provides are the 64-bit "double word" routines.  The 16- and
# 32-bit ones are here:
#
#   lib1funcs.S     __mulhi3 __mulsi3 __umulhisi3 __mulhisi3 __umulsidi3,
#                   the four 16-bit division helpers, the six 64-bit ones,
#                   and the 32- and 64-bit shifts by a variable count, hand
#                   written.
#                   GENERATED by tools/gen-lib1funcs.js from the customasm
#                   original, libgcc/lib1funcs.s in the fructus repository,
#                   whose suite checks this copy is not stale.  What the
#                   generator adds is a .globl and a SECTION OF ITS OWN per
#                   routine, so that --gc-sections drops the ones a program
#                   does not call: without it, one int multiply pulls in the
#                   32-bit helper, the 64-bit helper and all of division.
#   lib2div.c       16- and 32-bit division and remainder
#   lib2mul.c       __muldi3_mul, the 64-bit product -mmul calls, on top of
#                   lib1funcs.S's routines that use the multiplier
#   lib2bitcountHI.c  16-bit clz/ctz/popcount/parity/ffs/clrsb, msp430's
#                   file with clrsb added

LIB2ADD = \
	$(srcdir)/config/fructus/lib1funcs.S \
	$(srcdir)/config/fructus/lib2div.c \
	$(srcdir)/config/fructus/lib2mul.c \
	$(srcdir)/config/fructus/lib2bitcountHI.c

# libgcc2.c's own 64-bit shifts and divisions, which lib1funcs.S replaces.
# Left in, both would define the same symbols in different members of
# libgcc.a, and a program needing one of each member would fail to link.
# libgcc2.c's divisions were also each a complete copy of __udivmoddi4,
# 2.3K to 3.2K apiece; lib1funcs.S's six share one, 597 bytes in all.
LIB2FUNCS_EXCLUDE = _ashldi3 _lshrdi3 _ashrdi3 \
	_udivdi3 _umoddi3 _udivmoddi4 _divdi3 _moddi3 _divmoddi4

HOST_LIBGCC2_CFLAGS += -Os

# C only: no exceptions, so no unwinder, and no __builtin_eh_return to build
# one with.
LIB2ADDEH =

# Nor unwind tables in the 64-bit division routines, which libgcc otherwise
# builds with -fexceptions so that a trap could unwind through them.  Nothing
# here traps, and the tables only made ld complain about .eh_frame.
LIB2_DIVMOD_EXCEPTION_FLAGS := -fno-exceptions
